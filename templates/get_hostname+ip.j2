{#}
{% for host in groups['all'] %}
--------------------------------
HOST: {{ hostvars[host]['ansible_facts']['hostname'] }}, OS: {{ hostvars[host]['ansible_facts']['distribution'] }}, Version: {{ hostvars[host]['ansible_facts']['distribution_major_version'] }}
--------------------------------
{% endfor %}
{#}




global:
{% filter indent(width=2, first=true) %}
scrape_interval: 30s
evaluation_interval: 15s
{% endfilter %}
rule_files:
scrape_configs:
{% filter indent(width=2, first=true) %}
- job_name: 'public'
{% endfilter %}
{% filter indent(width=4, first=true) %}
scrape_interval: 5s
static_configs:
{% endfilter %}
{% filter indent(width=6, first=true) %}
{% for host in groups['prometheus_master'] %}
- targets: ['{{ host }}:9090']
{% filter indent(width=2, first=true) %}
labels:
{% filter indent(width=2, first=true) %}
domain: 'example'
project: 'infra-zone'
vpc: 'vpc-internal'
subnet: 'sub-internal-pri-a'
hostname: '{{ hostvars[host]['ansible_facts']['hostname'] }}'
ipv4: '{{ hostvars[host]['ansible_facts']['default_ipv4']['address'] }}'
service: 'prometheus'
type: 'prometheus-master'
{% endfilter %}
{% endfilter %}
{% endfor %}
{% endfilter %}


{% filter indent(width=6, first=true) %}
{% for host in groups['ext'] %}
